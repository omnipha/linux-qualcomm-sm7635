#!/bin/busybox sh
# SPDX-License-Identifier: GPL-2.0-only
set -u
export PATH=/bin:/sbin
export HOME=/root

log() {
	printf 'omnipha-init: %s\n' "$*" >/dev/kmsg 2>/dev/null || true
	printf 'omnipha-init: %s\n' "$*" >/dev/console 2>/dev/null || true
	printf 'omnipha-init: %s\n' "$*" >/dev/tty0 2>/dev/null || true
}

mkdir -p /proc /sys /dev /dev/pts /run /bin /sbin /root /etc /tmp /var/run
mount -t proc proc /proc
mount -t sysfs sysfs /sys
if ! mount -t devtmpfs devtmpfs /dev 2>/dev/null; then
	mount -t tmpfs devtmpfs /dev
fi
mount -t configfs configfs /sys/kernel/config 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true

[ -e /dev/null ] || mknod /dev/null c 1 3
[ -e /dev/zero ] || mknod /dev/zero c 1 5
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/kmsg ] || mknod /dev/kmsg c 1 11
[ -e /dev/ptmx ] || mknod /dev/ptmx c 5 2
[ -e /dev/tty0 ] || mknod /dev/tty0 c 4 0
[ -e /dev/tty1 ] || mknod /dev/tty1 c 4 1
[ -e /dev/tty ] || mknod /dev/tty c 5 0

printf 'root:x:0:0:root:/root:/bin/sh\n' >/etc/passwd
printf 'root:x:0:\n' >/etc/group
printf '/bin/sh\n' >/etc/shells
hostname milos-mainline

log 'Starting Omnipha mainline early-boot initramfs'

# 150-second self-recovery watchdog: returns to bootloader unless /run/keep is touched
{
	sleep 150
	if [ ! -e /run/keep ]; then
		log 'self-recovery watchdog expired without /run/keep; rebooting to bootloader'
		if [ -x /bin/restart2 ]; then
			/bin/restart2 bootloader || reboot -f
		else
			reboot -f
		fi
	fi
} &

# Identify device from device tree model
DT_MODEL="Unknown Device"
if [ -r /proc/device-tree/model ]; then
	DT_MODEL=$(tr -d '\0' </proc/device-tree/model)
fi
KERNEL_REL=$(uname -r)
KERNEL_VER=$(uname -v)

log "Device model: ${DT_MODEL}"
log "Kernel release: ${KERNEL_REL}"
log "Kernel version: ${KERNEL_VER}"

# Compose identity banner
cat >/etc/motd <<EOF
======================================================================
 Omnipha Mainline Linux for Qualcomm SM7635 (Milos)
 Device:  ${DT_MODEL}
 Kernel:  ${KERNEL_REL} (${KERNEL_VER})
 Address: 172.16.42.2 / 192.168.10.2 (USB CDC ECM/NCM)
 Access:  Key-only Dropbear SSH (root)
 Console: /dev/tty0 (bootloader framebuffer)
======================================================================
EOF
cp /etc/motd /etc/issue

# Print identity banner on display console (tty0) and system console
cat /etc/motd >/dev/tty0 2>/dev/null || true
cat /etc/motd >/dev/console 2>/dev/null || true

# Wait for UDC controller registration
UDC=""
i=0
while [ "$i" -lt 40 ]; do
	for candidate in /sys/class/udc/*; do
		if [ -e "$candidate" ]; then
			UDC=${candidate##*/}
			break
		fi
	done
	[ -n "$UDC" ] && break
	sleep 0.25
	i=$((i + 1))
done

if [ -z "$UDC" ]; then
	log 'ERROR: No UDC controller found under /sys/class/udc'
	if [ -r /sys/kernel/debug/devices_deferred ]; then
		while read -r line; do
			log "deferred probe: $line"
		done </sys/kernel/debug/devices_deferred
	fi
else
	log "Found UDC: ${UDC}"
	G=/sys/kernel/config/usb_gadget/g1
	mkdir -p "$G/strings/0x409" "$G/configs/c.1/strings/0x409"

	# Pinned gadget identity: Linux Foundation Multifunction Composite Gadget
	printf '0x1d6b' >"$G/idVendor"
	printf '0x0104' >"$G/idProduct"
	printf '0x0100' >"$G/bcdDevice"
	printf '0x0200' >"$G/bcdUSB"

	printf 'Omnipha' >"$G/strings/0x409/manufacturer"
	printf 'SM7635 Bringup Gadget' >"$G/strings/0x409/product"
	printf '0123456789' >"$G/strings/0x409/serialnumber"

	printf 'CDC Network' >"$G/configs/c.1/strings/0x409/configuration"
	printf '250' >"$G/configs/c.1/MaxPower"

	mkdir -p "$G/functions/ecm.usb0"
	mkdir -p "$G/functions/ncm.usb0"
	ln -s "$G/functions/ecm.usb0" "$G/configs/c.1/"
	ln -s "$G/functions/ncm.usb0" "$G/configs/c.1/"

	if err=$({ printf '%s' "$UDC" >"$G/UDC"; } 2>&1); then
		log "USB gadget successfully bound to ${UDC}"

		# Configure primary network interface (usb0) on lab subnet 172.16.42.0/24 and fallback 192.168.10.0/24
		if err=$(ip link set usb0 up 2>&1); then
			log 'usb0 link up: ok'
		else
			log "usb0 link up failed: ${err}"
		fi

		# Primary address: lab standard 172.16.42.2/24 (per phone-second-life standard and record #53)
		if err=$(ip addr add 172.16.42.2/24 dev usb0 2>&1); then
			log 'usb0 address 172.16.42.2/24: added'
		else
			log "usb0 address 172.16.42.2/24 failed: ${err}"
		fi

		# Secondary address: 192.168.10.2/24 compatibility
		if err=$(ip addr add 192.168.10.2/24 dev usb0 2>&1); then
			log 'usb0 address 192.168.10.2/24: added'
		else
			log "usb0 address 192.168.10.2/24 failed: ${err}"
		fi

		# If second function (usb1) was created, assign secondary subnet
		if [ -e /sys/class/net/usb1 ]; then
			ip link set usb1 up 2>/dev/null || true
			ip addr add 172.16.43.2/24 dev usb1 2>/dev/null || true
			ip addr add 192.168.11.2/24 dev usb1 2>/dev/null || true
			log 'usb1 interface configured (172.16.43.2/24 / 192.168.11.2/24)'
		fi

		# Log active network configuration
		ip addr show dev usb0 2>&1 | while IFS= read -r line; do
			log "net: ${line}"
		done
	else
		log "USB gadget bind failed for ${UDC}: ${err}"
	fi
fi

# Start Dropbear SSH server on all interfaces (port 22)
mkdir -p /etc/dropbear /var/run
if [ -x /bin/dropbear ]; then
	if /bin/dropbear -E -R -p 22 2>&1 | while IFS= read -r line; do log "dropbear: ${line}"; done & then
		log 'Dropbear SSH server started on port 22'
	else
		log 'ERROR: Failed to start Dropbear SSH server'
	fi

	# Verify listener in /proc/net/tcp
	sleep 1
	if grep -q ":0016" /proc/net/tcp 2>/dev/null; then
		log 'Dropbear listener verified active on port 22'
	else
		log 'Dropbear listener not yet observed in /proc/net/tcp'
	fi
fi

cat /etc/motd >/dev/tty0 2>/dev/null || true
cat /etc/motd >/dev/console 2>/dev/null || true
log 'Initramfs preparation complete. Starting console shell.'

# Start interactive shell on console
exec setsid cttyhack /bin/sh </dev/console >/dev/console 2>&1
