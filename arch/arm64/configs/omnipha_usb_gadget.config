# SPDX-License-Identifier: GPL-2.0-only
#
# Omnipha USB device-mode and early console configuration fragment for SM7635/Milos.
# Ensures built-in support for eUSB2 PHY, PMIV0104 repeater, DWC3 dual-role controller,
# ConfigFS gadget infrastructure, serial console (ACM), USB networking (CDC ECM/NCM),
# SimpleDRM bootloader framebuffer display, and high-DPI framebuffer console.

CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_ROLE_SWITCH=y

CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y

CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y

CONFIG_USB_U_SERIAL=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_SERIAL=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_NCM=y
CONFIG_USB_F_ECM=y
CONFIG_USB_F_ECM_SUBSET=y

# Early display console via bootloader framebuffer (SimpleDRM + fbcon)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
